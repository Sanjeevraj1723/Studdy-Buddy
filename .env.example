# Copy this file to ".env" and fill in ONE key. Never share or upload .env.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash

# To use Claude instead, set AI_PROVIDER=claude and add:
# ANTHROPIC_API_KEY=your-claude-key-here
# CLAUDE_MODEL=claude-sonnet-5-5

# Max AI requests per visitor per day (protects your bill)
DAILY_LIMIT=30
